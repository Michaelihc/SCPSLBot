<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>NavMeshAssetPatcher</RootNamespace>
    <AssemblyName>NavMeshAssetPatcher</AssemblyName>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Tools-only dependency; the SCPSLBot plugin never references this project. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- UABE class database (type trees for player builds, which strip them). -->
    <None Include="classdata.tpk" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
