<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(SCPSL_METAREPO)\build\scpsl-deps.props" Condition="'$(SCPSL_METAREPO)' != '' And Exists('$(SCPSL_METAREPO)\build\scpsl-deps.props')" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>warnings</Nullable>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <ImplicitlyExpandDesignTimeFacades>false</ImplicitlyExpandDesignTimeFacades>
    <AssemblyName>BotRoundControl</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
    <SCP_SL_MANAGED Condition="'$(SCP_SL_MANAGED)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed</SCP_SL_MANAGED>
    <AssemblySearchPaths>$(SL_REFERENCES);$(SCP_SL_MANAGED);$(AssemblySearchPaths)</AssemblySearchPaths>
    <!-- The shared CustomItems sources carry nullable annotations; this project compiles with warnings-only nullability. -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SCPSLBot\SCPSLBot.csproj" />
    <ProjectReference Include="$(ServerKeybindsProject)" Private="false" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
    <PackageReference Include="IsExternalInit" Version="1.0.3" />
    <Reference Include="LabApi" Private="false" />
    <Reference Include="Assembly-CSharp" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" Private="false" />
    <Reference Include="CommandSystem.Core" Private="false" />
    <Reference Include="Mirror" Private="false" />
    <Reference Include="Pooling" Private="false" />
    <Reference Include="UnityEngine.CoreModule" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" Private="false" />
    <Reference Include="UnityEngine.AIModule" Private="false" />
    <Reference Include="System.Text.Json" Private="false" />
    <Reference Include="System.Memory" Private="false" />
    <Reference Include="mscorlib" />
    <Reference Include="netstandard" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <EmbeddedResource Include="Duel\Assets\arena.json" LogicalName="DuelArena.arena.json" />
    <!-- WithCulture=false: "mer" is also a culture name, which would move these into a satellite assembly. -->
    <EmbeddedResource Include="Warmup\SpecialWeapons\Assets\*.mer.json" LogicalName="SpecialWeapons.%(Filename)%(Extension)" WithCulture="false" />
    <Compile Include="..\Shared\WarmupParticipationPolicy.cs" Link="Shared\WarmupParticipationPolicy.cs" />
    <Compile Condition="'$(CustomItemsSource)' != ''" Include="$(CustomItemsSource)\**\*.cs" Link="CustomItems\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireCustomItemsSource" BeforeTargets="BeforeBuild" Condition="!Exists('$(CustomItemsSource)')">
    <Error Text="CustomItems sources not found. Set SCPSL_METAREPO to the metarepo checkout, or pass -p:CustomItemsSource=&lt;path to CustomItems\src&gt;." />
  </Target>
  <Target Name="RequireServerKeybinds" BeforeTargets="BeforeBuild" Condition="!Exists('$(ServerKeybindsProject)')">
    <Error Text="ServerKeybinds source not found. Set SCPSL_METAREPO to the metarepo checkout, or pass -p:ServerKeybindsProject=&lt;path to ServerKeybinds.csproj&gt;." />
  </Target>
</Project>
